# Personal/portfolio data - real account holdings, never leave this machine.
# (all_rows.html/nasdaq-stocks.html are also protected via the git clean
# filter in .gitattributes - this is a second, independent layer for the
# raw source files themselves.)
portfolio_real.tsv
portfolio_real_tp.tsv
portfolio_virtual.tsv
portfolio_tp.tsv

# Real Chrome/Playwright profile directories used for the live eToro login
# session (SCAN HOLDINGS/SCAN RED) - contain actual account cookies/session
# tokens/autofill data. Must never be committed under any circumstances.
.etoro_session/
.etoro_user_session/

# Local-only settings/state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.build_site.lock

# Intermediate per-shard scan output from the parallel cloud pipeline
# (megascan.py/megascan_yahoo.py/fundamentals_scan.py with SHARD_COUNT>1) -
# consumed once by aggregate_scan_shards.py and pointless to keep afterward;
# the aggregate job's own "git add -A" swept these into main by accident on
# the first parallel run before this rule existed.
shard_out/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
Thumbs.db
